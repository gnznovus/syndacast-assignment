{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1920px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "muu-black", "name": "MUU Black", "color": "#000000" },
        { "slug": "muu-white", "name": "MUU White", "color": "#ffffff" },
        { "slug": "muu-orange", "name": "MUU Orange", "color": "#fe5000" },
        { "slug": "muu-gray", "name": "MUU Gray", "color": "#e6e6e6" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "fontSizes": [
        { "slug": "muu-xs", "name": "MUU XS", "size": "12px" },
        { "slug": "muu-nav", "name": "MUU Navigation", "size": "16px" },
        { "slug": "muu-body", "name": "MUU Body", "size": "18px" },
        { "slug": "muu-label", "name": "MUU Label", "size": "30px" },
        { "slug": "muu-heading", "name": "MUU Heading", "size": "50px" },
        { "slug": "muu-display", "name": "MUU Display", "size": "188px" }
      ],
      "fontFamilies": [
        {
          "slug": "butler",
          "name": "Butler",
          "fontFamily": "Butler, Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Butler",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/Butler/Butler.woff2"]
            },
            {
              "fontFamily": "Butler",
              "fontStyle": "normal",
              "fontWeight": "500",
              "src": ["file:./assets/fonts/Butler/Butler-Medium.woff2"]
            },
            {
              "fontFamily": "Butler",
              "fontStyle": "normal",
              "fontWeight": "900",
              "src": ["file:./assets/fonts/Butler/Butler-Black.woff2"]
            }
          ]
        },
        {
          "slug": "hk-grotesk",
          "name": "HK Grotesk",
          "fontFamily": "'HK Grotesk', Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "HK Grotesk",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/HKGrotesk/HKGrotesk-Regular.woff2"]
            },
            {
              "fontFamily": "HK Grotesk",
              "fontStyle": "normal",
              "fontWeight": "600",
              "src": ["file:./assets/fonts/HKGrotesk/HKGrotesk-SemiBold.woff2"]
            },
            {
              "fontFamily": "HK Grotesk",
              "fontStyle": "normal",
              "fontWeight": "700",
              "src": ["file:./assets/fonts/HKGrotesk/HKGrotesk-Bold.woff2"]
            }
          ]
        }
      ]
    },
    "spacing": {
      "customSpacingSize": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "muu-xs", "name": "MUU XS", "size": "8px" },
        { "slug": "muu-sm", "name": "MUU Small", "size": "16px" },
        { "slug": "muu-md", "name": "MUU Medium", "size": "32px" },
        { "slug": "muu-lg", "name": "MUU Large", "size": "64px" },
        { "slug": "muu-xl", "name": "MUU XL", "size": "96px" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "minHeight": true
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|muu-white",
      "text": "#111111"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|hk-grotesk",
      "fontSize": "var:preset|font-size|muu-body"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|butler",
          "fontWeight": "400"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
